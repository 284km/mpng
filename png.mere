// png.mere — reading PNG (RFC 2083), in pure Mere.
//
// A module: definitions only, no program. `mpng.mere` is the CLI.
//
// The shape of a PNG is: an 8-byte signature, then a sequence of chunks, each
// one a length, a four-character type, that many bytes, and a CRC. The image
// itself is in the IDAT chunks, which hold one zlib stream split across them —
// so the bytes have to be concatenated before they mean anything, and a decoder
// that inflates each chunk on its own works on most files and fails on large
// ones.
//
// Inflating is `mgz`, which is this project's own gzip implementation used as a
// package rather than copied in. zlib is DEFLATE with two bytes in front and a
// checksum behind, so `inflate data 2` is the whole of it.
//
// Exports:
//   is_png       data          -> bool
//   read_header  data          -> vec   [width, height, depth, colour, interlace]
//   decode       data          -> vec   raw pixel SAMPLES, one byte each (two at
//                                        16 bits), filters undone and any packing
//                                        below 8 bits expanded
//   channels     colour_type   -> int
//   palette      data          -> vec   PLTE as r,g,b triples (empty if none)
//   text_chunks  data          -> vec   tEXt chunks as "keyword: text"
//   gamma        data          -> int   gAMA in hundred-thousandths, 0 if absent
//   has_transparency data      -> bool  is there a tRNS chunk
//   trns         data          -> vec   tRNS's raw bytes (empty if none); what they
//                                        mean depends on the colour type
//   rgb8         data          -> vec   three bytes a pixel, whatever the file was

import "mgz/inflate.mere";

// A fixed-size vec, zeroed. Not a builtin: `vec_new` grows by pushing, and a
// decoder that reconstructs scanlines needs to write into the middle of one.
let new_vec = fn (n: int) -> fn (x: int) ->
  let v = vec_new () in
  let rec go = fn i -> if i >= n then () else let _ = vec_push v x in go (i + 1) in
  let _ = go 0 in
  v;

// 137 P N G \r \n 26 \n — the last four catch a file mangled by a transfer that
// thought it was text, which is why they are there.
let png_sig =
  let v = vec_new () in
  let rec go = fn i ->
    if i >= 8 then ()
    else
      let b =
        if i == 0 then 137 else if i == 1 then 80 else if i == 2 then 78
        else if i == 3 then 71 else if i == 4 then 13 else if i == 5 then 10
        else if i == 6 then 26 else 10 in
      let _ = vec_push v b in
      go (i + 1) in
  let _ = go 0 in
  v;

let is_png = fn data ->
  if vec_len data < 8 then false
  else
    let rec go = fn i ->
      if i == 8 then true
      else if vec_get data i != vec_get png_sig i then false
      else go (i + 1) in
    go 0;

// Big-endian, unlike DEFLATE's little-endian bit order — a PNG carries both
// conventions and mixing them up is the first bug everybody writes.
let u32be = fn data -> fn (i: int) ->
  vec_get data i * 16777216
  + vec_get data (i + 1) * 65536
  + vec_get data (i + 2) * 256
  + vec_get data (i + 3);

// A chunk's type is four ASCII characters at a known offset; comparing them as
// numbers avoids building a string per chunk.
let type_is = fn data -> fn (i: int) -> fn (a: int) -> fn (b: int) -> fn (c: int) -> fn (d: int) ->
  vec_get data i == a && vec_get data (i + 1) == b
  && vec_get data (i + 2) == c && vec_get data (i + 3) == d;

let is_ihdr = fn data -> fn i -> type_is data i 73 72 68 82;   // IHDR
let is_idat = fn data -> fn i -> type_is data i 73 68 65 84;   // IDAT
let is_iend = fn data -> fn i -> type_is data i 73 69 78 68;   // IEND
let is_plte = fn data -> fn i -> type_is data i 80 76 84 69;   // PLTE
let is_text = fn data -> fn i -> type_is data i 116 69 88 116;  // tEXt
let is_gama = fn data -> fn i -> type_is data i 103 65 77 65;  // gAMA
let is_trns = fn data -> fn i -> type_is data i 116 82 78 83;  // tRNS

// [width, height, bit depth, colour type, interlace]
let read_header = fn data ->
  let rec walk = fn (pos: int) ->
    if pos + 8 > vec_len data then vec_new ()
    else
      let len = u32be data pos in
      if is_ihdr data (pos + 4) then
        let d = pos + 8 in
        let h = vec_new () in
        let _ = vec_push h (u32be data d) in
        let _ = vec_push h (u32be data (d + 4)) in
        let _ = vec_push h (vec_get data (d + 8)) in
        let _ = vec_push h (vec_get data (d + 9)) in
        let _ = vec_push h (vec_get data (d + 12)) in
        h
      else walk (pos + 12 + len) in
  walk 8;

// Samples per pixel, by colour type: 0 grey, 2 RGB, 3 palette index, 4
// grey+alpha, 6 RGBA. Palette is an index into a table, so one sample wide here
// even though what it stands for is three.
let channels = fn (colour: int) ->
  if colour == 0 then 1
  else if colour == 2 then 3
  else if colour == 3 then 1
  else if colour == 4 then 2
  else if colour == 6 then 4
  else 0;

// Bytes per pixel IN THE DECODED OUTPUT, which is one byte a sample except at
// 16 bits, where it is two. This is the stride every consumer of `decode` uses.
//
// It is NOT the stride of the bytes in the file. Below 8 bits a scanline is
// PACKED -- two 4-bit samples to a byte, eight 1-bit ones -- and `decode`
// expands them, so this number describes what comes out and `scanline_bytes`
// describes what went in. Those were the same function once, and the result was
// that a 4-bit palette image made the decoder read twice as many bytes per row
// as the row had: 1000 pixels at 4 bits is 500 bytes, the loop asked for 1000,
// and it ran off the end of the last row by exactly the number of filter bytes
// it had skipped. Two of Khronos's glTF sample models are 4-bit palettes.
let pixel_bytes = fn (colour: int) -> fn (depth: int) ->
  channels colour * (if depth == 16 then 2 else 1);

// Bits a pixel, straight from the header: samples times their width.
let bits_per_pixel = fn (colour: int) -> fn (depth: int) -> channels colour * depth;

// The bytes one scanline occupies IN THE FILE, rounded up -- a row of 3 pixels
// at 1 bit is one byte with five bits of padding, and the padding is not carried
// over into the next row.
let scanline_bytes = fn (colour: int) -> fn (depth: int) -> fn (width: int) ->
  (width * bits_per_pixel colour depth + 7) / 8;

// How far back `left` is, for the filters. RFC 2083 says: the number of bytes
// per pixel, ROUNDED UP, and at least one -- so every depth below 8 uses 1, and
// the filters at those depths work on bytes that hold several pixels each. That
// is the specification's choice, not a simplification of it.
let filter_step = fn (colour: int) -> fn (depth: int) ->
  let b = (bits_per_pixel colour depth + 7) / 8 in
  if b < 1 then 1 else b;

// Which bit depths each colour type may have (RFC 2083 table, 11.2.2). A file
// outside this table is broken rather than exotic, and decoding it would mean
// inventing a meaning for a combination the format does not define.
let depth_ok = fn (colour: int) -> fn (depth: int) ->
  if colour == 0 then depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16
  else if colour == 3 then depth == 1 || depth == 2 || depth == 4 || depth == 8
  else if colour == 2 || colour == 4 || colour == 6 then depth == 8 || depth == 16
  else false;

let check_depth = fn (colour: int) -> fn (depth: int) ->
  if depth_ok colour depth then ()
  else fail ("png: colour type " ++ str_of_int colour ++ " with bit depth "
             ++ str_of_int depth ++ " is not supported -- RFC 2083 does not define it");

// One sample out of a PACKED row, by index. `depth` is 1, 2 or 4, so a byte
// holds 8, 4 or 2 of them, MOST SIGNIFICANT FIRST -- the opposite order from
// DEFLATE's bits, which is the second place this format carries both
// conventions.
let packed_sample = fn row -> fn (at: int) -> fn (depth: int) -> fn (i: int) ->
  let per = 8 / depth in
  let b = bytebuf_get row (at + i / per) in
  let shift = 8 - depth * (i % per + 1) in
  let rec pow2 = fn (n: int) -> if n <= 0 then 1 else 2 * pow2 (n - 1) in
  (b / pow2 shift) % pow2 depth;

// PLTE, as r,g,b triples. Empty when the file has none, which is every colour
// type but 3.
let palette = fn data ->
  let out = vec_new () in
  let n = vec_len data in
  let rec walk = fn (pos: int) ->
    if pos + 8 > n then out
    else
      let len = u32be data pos in
      if is_iend data (pos + 4) then out
      else if is_plte data (pos + 4) then
        let rec copy = fn (i: int) ->
          if i == len then out
          else let _ = vec_push out (vec_get data (pos + 8 + i)) in copy (i + 1) in
        copy 0
      else walk (pos + 12 + len) in
  walk 8;

// Every IDAT, in order, as one vec: the zlib stream is split across them at
// arbitrary points, so this is not optional.
let idat_bytes = fn data ->
  let out = vec_new () in
  let n = vec_len data in
  let rec walk = fn (pos: int) ->
    if pos + 8 > n then out
    else
      let len = u32be data pos in
      if is_iend data (pos + 4) then out
      else
        let _ =
          if is_idat data (pos + 4) then
            let rec copy = fn (i: int) ->
              if i == len then ()
              else let _ = vec_push out (vec_get data (pos + 8 + i)) in copy (i + 1) in
            copy 0
          else () in
        walk (pos + 12 + len) in
  walk 8;

// --- what else the file says -----------------------------------------------
//
// Ancillary chunks: the ones a decoder may ignore and a reader may want. Their
// lower-case first letter is the convention that says so, which is why `tEXt` and
// `IHDR` differ in more than name.

// The text of every tEXt chunk, as "keyword: text" lines. A tEXt is a keyword,
// a zero byte, then Latin-1 text — the zero is a separator inside the chunk, not
// a terminator, which is a small reminder of why `bytes` exists.
let text_chunks = fn data ->
  let out = vec_new () in
  let n = vec_len data in
  let rec walk = fn (pos: int) ->
    if pos + 8 > n then out
    else
      let len = u32be data pos in
      if is_iend data (pos + 4) then out
      else
        let _ =
          if is_text data (pos + 4) then
            let d = pos + 8 in
            let buf = strbuf_new () in
            let rec chars = fn (i: int) -> fn (seen_sep: bool) ->
              if i == len then ()
              else
                let b = vec_get data (d + i) in
                if b == 0 && seen_sep == false then
                  let _ = strbuf_push buf ": " in
                  chars (i + 1) true
                else
                  let _ = strbuf_push buf (chr b) in
                  chars (i + 1) seen_sep in
            let _ = chars 0 false in
            vec_push out (strbuf_to_str buf)
          else () in
        walk (pos + 12 + len) in
  walk 8;

// gAMA, in hundred-thousandths as the file stores it. `0` for absent, which is
// not a gamma anybody means.
let gamma = fn data ->
  let n = vec_len data in
  let rec walk = fn (pos: int) ->
    if pos + 8 > n then 0
    else
      let len = u32be data pos in
      if is_iend data (pos + 4) then 0
      else if is_gama data (pos + 4) then u32be data (pos + 8)
      else walk (pos + 12 + len) in
  walk 8;

// tRNS, as its raw bytes. WHAT THEY MEAN DEPENDS ON THE COLOUR TYPE, and the
// three meanings are not variations of one:
//
//   palette (3): one ALPHA BYTE PER PALETTE ENTRY, in order, and the chunk may be
//                shorter than the palette -- every entry past its end is opaque.
//   grey (0):    a two-byte SAMPLE VALUE that is fully transparent (a colour key).
//   RGB (2):     three two-byte sample values, the same way.
//
// It is returned raw rather than expanded because expanding it needs the colour
// type, and a function that took the colour type would be deciding for its
// caller which of the three questions it is asking.
let trns = fn data ->
  let out = vec_new () in
  let n = vec_len data in
  let rec walk = fn (pos: int) ->
    if pos + 8 > n then out
    else
      let len = u32be data pos in
      if is_iend data (pos + 4) then out
      else if is_trns data (pos + 4) then
        let rec copy = fn (i: int) ->
          if i >= len then out
          else let _ = vec_push out (vec_get data (pos + 8 + i)) in copy (i + 1) in
        copy 0
      else walk (pos + 12 + len) in
  walk 8;

let has_transparency = fn data ->
  let n = vec_len data in
  let rec walk = fn (pos: int) ->
    if pos + 8 > n then false
    else
      let len = u32be data pos in
      if is_iend data (pos + 4) then false
      else if is_trns data (pos + 4) then true
      else walk (pos + 12 + len) in
  walk 8;

// --- undoing the scanline filters (RFC 2083 §6) ---------------------------
//
// Each scanline is preceded by one byte saying how it was filtered, and each
// filter predicts a byte from its neighbours: the one to the left, the one
// above, or both. Undoing them has to happen in order, because a scanline is
// reconstructed against the *reconstructed* line above it, not the raw one.

let paeth = fn (a: int) -> fn (b: int) -> fn (c: int) ->
  let p = a + b - c in
  let pa = if p >= a then p - a else a - p in
  let pb = if p >= b then p - b else b - p in
  let pc = if p >= c then p - c else c - p in
  if pa <= pb && pa <= pc then a
  else if pb <= pc then b
  else c;

// `raw` is the inflated stream: (1 + stride) bytes per scanline. The result is
// the same rows with the filter bytes gone and the prediction undone.
//
// The output is a `ByteBuf`: one byte per byte, and random access both ways,
// which is what this needs — a row is reconstructed against the row above it,
// already reconstructed, so every byte written is read again. A `Vec[R, int]`
// does the same job at eight bytes a byte (see PAIN.md P2, which asked for this
// type; it arrived in mere v0.1.218).
// `start` is where in the inflated stream these scanlines begin — zero for an
// ordinary image, and the running offset of a pass for an interlaced one.
// THE FILTERS RUN ON THE FILE'S BYTES, NOT ON PIXELS. That distinction is the
// whole of what this function has to get right below 8 bits: the reconstruction
// works in PACKED bytes at `pline` a row, stepping `fstep` back for `left`, and
// only afterwards are the samples spread out one to a byte.
//
// Doing it the other way round -- expanding first and filtering the expansion --
// decodes an 8-bit image perfectly and every 4-bit one into noise, because
// `left` would then be a different byte from the one the encoder subtracted.
let unfilter_at = fn raw -> fn (start: int) -> fn (colour: int) -> fn (depth: int) ->
                  fn (width: int) -> fn (height: int) ->
  let pline = scanline_bytes colour depth width in
  let fstep = filter_step colour depth in
  let packed = bytebuf_new (pline * height) in
  let rec row = fn (y: int) ->
    if y == height then ()
    else
      let src = start + y * (pline + 1) in
      let ft = vec_get raw src in
      let dst = y * pline in
      let rec col = fn (x: int) ->
        if x == pline then ()
        else
          let cur = vec_get raw (src + 1 + x) in
          let left = if x >= fstep then bytebuf_get packed (dst + x - fstep) else 0 in
          let up = if y > 0 then bytebuf_get packed (dst - pline + x) else 0 in
          let upleft =
            if y > 0 && x >= fstep then bytebuf_get packed (dst - pline + x - fstep) else 0 in
          let v =
            if ft == 0 then cur
            else if ft == 1 then cur + left
            else if ft == 2 then cur + up
            else if ft == 3 then cur + (left + up) / 2
            else if ft == 4 then cur + paeth left up upleft
            else cur in
          let _ = bytebuf_set packed (dst + x) v in
          col (x + 1) in
      let _ = col 0 in
      row (y + 1) in
  let _ = row 0 in
  if depth >= 8 then packed
  else
    // One sample to a byte, VALUES UNCHANGED. A 4-bit palette sample is an index
    // into PLTE and must stay 0..15; a 4-bit grey sample is a level out of 15 and
    // wants scaling to 0..255, but that is a decision about DISPLAY and it
    // belongs in `rgb8`, not in a function that promises raw samples.
    //
    // The row's trailing padding bits are dropped here rather than carried: a
    // scanline is padded to a byte and the next one starts fresh, so a decoder
    // that treats the stream as one long bit sequence drifts by a fraction of a
    // byte per row and produces a picture that shears.
    let nch = channels colour in
    let out = bytebuf_new (width * nch * height) in
    let rec erow = fn (y: int) ->
      if y == height then out
      else
        let rec es = fn (i: int) ->
          if i == width * nch then ()
          else
            let _ = bytebuf_set out (y * width * nch + i)
                                   (packed_sample packed (y * pline) depth i) in
            es (i + 1) in
        let _ = es 0 in
        erow (y + 1) in
    erow 0;

// `bpp` ALONE CANNOT SAY WHICH COLOUR TYPE IT CAME FROM -- two bytes a pixel is
// 16-bit grey or 8-bit grey-with-alpha, and the filters step differently for
// each -- so nothing here takes one. The callers pass the header's own numbers.
let unfilter = fn raw -> fn (colour: int) -> fn (depth: int) -> fn (width: int) -> fn (height: int) ->
  unfilter_at raw 0 colour depth width height;

let is_interlaced = fn data ->
  let h = read_header data in
  vec_len h == 5 && vec_get h 4 == 1;

// --- Adam7 -----------------------------------------------------------------
//
// An interlaced PNG is not one image but seven, each a subsampling of it on a
// different lattice, stored one after another and each filtered as if it were an
// image of its own. Pass 1 is every eighth pixel of every eighth row; pass 7 is
// every other pixel of the odd rows. So a decoder cannot treat the stream as
// scanlines at all until it knows which pass it is in — and the passes have
// different widths, which means different strides, which means the filters read
// different neighbours.
//
// The tables are the standard ones: where each pass starts in x and y, and how
// far it steps.
let adam7_xstart = fn (p: int) ->
  if p == 0 then 0 else if p == 1 then 4 else if p == 2 then 0
  else if p == 3 then 2 else if p == 4 then 0 else if p == 5 then 1 else 0;
let adam7_ystart = fn (p: int) ->
  if p == 0 then 0 else if p == 1 then 0 else if p == 2 then 4
  else if p == 3 then 0 else if p == 4 then 2 else if p == 5 then 0 else 1;
let adam7_xstep = fn (p: int) ->
  if p == 0 then 8 else if p == 1 then 8 else if p == 2 then 4
  else if p == 3 then 4 else if p == 4 then 2 else if p == 5 then 2 else 1;
let adam7_ystep = fn (p: int) ->
  if p == 0 then 8 else if p == 1 then 8 else if p == 2 then 8
  else if p == 3 then 4 else if p == 4 then 4 else if p == 5 then 2 else 2;

// How many pixels/rows a pass has: the count of lattice points that land inside
// the image. A pass with none of either is skipped entirely — it contributes no
// bytes at all, not even a filter byte, which is the detail that shifts every
// later pass if it is missed.
let ceil_div = fn (a: int) -> fn (b: int) -> (a + b - 1) / b;
let pass_width = fn (p: int) -> fn (width: int) ->
  ceil_div (width - adam7_xstart p) (adam7_xstep p);
let pass_height = fn (p: int) -> fn (height: int) ->
  ceil_div (height - adam7_ystart p) (adam7_ystep p);

// The seven passes, unfiltered in turn and scattered back into one image.
//
// Each pass is unfiltered *as its own image* — its own stride, its own first row
// with no row above — and then its pixels are written to where they belong. The
// scatter is the only part that knows the image is interlaced; everything before
// it is the ordinary decoder run seven times.
let deinterlace = fn raw -> fn (colour: int) -> fn (depth: int) ->
                  fn (width: int) -> fn (height: int) ->
  let bpp = pixel_bytes colour depth in
  let out = bytebuf_new (width * height * bpp) in
  let rec pass = fn (p: int) -> fn (off: int) ->
    if p == 7 then out
    else
      let pw = pass_width p width in
      let ph = pass_height p height in
      if pw <= 0 || ph <= 0 then pass (p + 1) off
      else
        // Each pass is unfiltered at ITS OWN WIDTH, which below 8 bits means its
        // own packing and its own trailing padding -- a pass 3 pixels wide at 4
        // bits occupies 2 bytes a row, not 1.5.
        let sub = unfilter_at raw off colour depth pw ph in
        let rec place = fn (y: int) ->
          if y == ph then ()
          else
            let rec px = fn (x: int) ->
              if x == pw then ()
              else
                let sx = adam7_xstart p + x * adam7_xstep p in
                let sy = adam7_ystart p + y * adam7_ystep p in
                let src = (y * pw + x) * bpp in
                let dst = (sy * width + sx) * bpp in
                let rec byte = fn (k: int) ->
                  if k == bpp then ()
                  else
                    let _ = bytebuf_set out (dst + k) (bytebuf_get sub (src + k)) in
                    byte (k + 1) in
                let _ = byte 0 in
                px (x + 1) in
            let _ = px 0 in
            place (y + 1) in
        let _ = place 0 in
        // Each pass costs one filter byte per row plus its own PACKED stride.
        pass (p + 1) (off + ph * (scanline_bytes colour depth pw + 1)) in
  pass 0 0;

// Raw pixel bytes: `pixel_bytes` per pixel, row-major, filters undone.
let decode = fn data ->
  let h = read_header data in
  if vec_len h == 0 then bytebuf_new 0
  else
    let width = vec_get h 0 in
    let height = vec_get h 1 in
    let depth = vec_get h 2 in
    let colour = vec_get h 3 in
    let _ = check_depth colour depth in
    // zlib: two bytes of header, then the DEFLATE stream mgz knows how to read.
    let raw = inflate (idat_bytes data) 2 in
    if vec_get h 4 == 1 then deinterlace raw colour depth width height
    else unfilter raw colour depth width height;

// Three bytes a pixel, whatever the file was: grey expanded, alpha dropped,
// palette looked up, and a 16-bit sample reduced to its high byte.
//
// The high byte rather than a proper reduction: 16-bit PNG samples are
// big-endian, so the high byte *is* the 8-bit approximation of the value, and
// pretending to do better would mean choosing a colour space.
let rgb8 = fn data ->
  let h = read_header data in
  let width = vec_get h 0 in
  let height = vec_get h 1 in
  let depth = vec_get h 2 in
  let colour = vec_get h 3 in
  let bpp = pixel_bytes colour depth in
  let step = if depth == 16 then 2 else 1 in
  let pixels = decode data in
  let pal = palette data in
  // A GREY SAMPLE BELOW 8 BITS IS A LEVEL OUT OF ITS OWN MAXIMUM, so 4-bit grey
  // runs 0..15 and has to be scaled to 0..255 to mean the same brightness. The
  // scaling is 255/(2^d - 1), which is exact for every depth PNG allows -- 1 bit
  // scales by 255, 2 by 85, 4 by 17 -- so it is a multiply and not a rounding
  // question. A decoder that skips it produces an image that is technically
  // right and visibly almost black.
  //
  // A PALETTE SAMPLE IS NOT SCALED. It is an index, and multiplying an index by
  // 17 looks up the wrong colour.
  let gscale =
    if colour == 3 || depth >= 8 then 1
    else if depth == 1 then 255 else if depth == 2 then 85 else 17 in
  let out = vec_new () in
  let rec go = fn (i: int) ->
    if i == width * height then out
    else
      let p = i * bpp in
      let s0 = bytebuf_get pixels p * gscale in
      let _ =
        if colour == 3 then
          // An index into PLTE. An index past the end of the table is a broken
          // file; black is a better answer than a crash.
          let e = bytebuf_get pixels p * 3 in
          if e + 2 < vec_len pal then
            let _ = vec_push out (vec_get pal e) in
            let _ = vec_push out (vec_get pal (e + 1)) in
            vec_push out (vec_get pal (e + 2))
          else
            let _ = vec_push out 0 in
            let _ = vec_push out 0 in
            vec_push out 0
        else if colour == 0 || colour == 4 then
          let _ = vec_push out s0 in
          let _ = vec_push out s0 in
          vec_push out s0
        else
          // Colour types 2 and 6 are 8- or 16-bit only, so `gscale` is 1 here by
          // construction; the raw samples are read directly rather than relying
          // on that, because a scaled red beside two unscaled others is the kind
          // of asymmetry that survives every test until the day it does not.
          let _ = vec_push out (bytebuf_get pixels p) in
          let _ = vec_push out (bytebuf_get pixels (p + step)) in
          vec_push out (bytebuf_get pixels (p + step * 2)) in
      go (i + 1) in
  go 0;
