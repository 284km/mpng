// mpng — read a PNG.
//
//   mpng info <file.png>        what the header says
//   mpng ppm  <file.png>        the pixels, as a PPM on stdout
//
// PPM because it is the format with no format: a header and the bytes, which
// makes the output something another tool can check rather than something you
// have to take on trust.
import "./png.mere";
import "./encode.mere";

let colour_name = fn (c: int) ->
  if c == 0 then "grey"
  else if c == 2 then "rgb"
  else if c == 3 then "palette"
  else if c == 4 then "grey+alpha"
  else if c == 6 then "rgba"
  else "unknown";

let info = fn data ->
  let h = read_header data in
  if vec_len h == 0 then print "no IHDR: not a PNG this can read"
  else
    print (str_of_int (vec_get h 0) ++ "x" ++ str_of_int (vec_get h 1)
           ++ " " ++ str_of_int (vec_get h 2) ++ "-bit "
           ++ colour_name (vec_get h 3)
           ++ (if vec_get h 4 == 1 then " interlaced" else ""));

// P6 is binary PPM: three bytes a pixel, no alpha, no compression.
//
// It is built as a vec of bytes and handed to `write_file_bytes`, rather than
// printed. Printing it is what the first version did, and it does not work: a
// Mere `str` is a NUL-terminated C string in the compiled backends, so
// `print_no_nl (chr 0)` writes nothing at all there while the interpreter writes
// the zero byte. An image with a black pixel in it came out shorter than it went
// in, and differently shorter depending on which backend ran. See PAIN.md.
let ppm_bytes = fn data ->
  let h = read_header data in
  let out = vec_new () in
  let rec header = fn (s: str) -> fn (i: int) ->
    if i >= str_len s then ()
    else
      let _ = vec_push out (ord (char_at s i)) in
      header s (i + 1) in
  let _ = header ("P6\n" ++ str_of_int (vec_get h 0) ++ " "
                  ++ str_of_int (vec_get h 1) ++ "\n255\n") 0 in
  let rgb = rgb8 data in
  let n = vec_len rgb in
  let rec go = fn (i: int) ->
    if i == n then out
    else let _ = vec_push out (vec_get rgb i) in go (i + 1) in
  go 0;

// Reading a PPM back, so `encode` has something to encode. P6 only, and only
// the header shape this project's own `ppm` writes — a full PPM parser is not
// what is being tested here.
let read_ppm = fn data ->
  let n = vec_len data in
  let acc = vec_new () in
  // Three whitespace-separated numbers after "P6": width, height, maxval, then
  // where the pixels start.
  //
  // The accumulator is captured rather than passed. Passing it made this an
  // inner `let rec` with five curried parameters ending in a vec, and the C
  // backend emits a forward declaration for that whose closure type name it
  // never defines — twelve lines reproduce it, see PAIN.md P5. Capturing it is
  // better code anyway; it is a mutable buffer, not a value being threaded.
  let rec fields = fn (i: int) -> fn (got: int) -> fn (cur: int) -> fn (seen: int) ->
    if i >= n then ()
    else
      let c = vec_get data i in
      if c >= 48 && c <= 57 then fields (i + 1) got (cur * 10 + c - 48) 1
      else if seen == 1 then
        let _ = vec_push acc cur in
        if got == 2 then let _ = vec_push acc (i + 1) in ()
        else fields (i + 1) (got + 1) 0 0
      else fields (i + 1) got 0 0 in
  let _ = fields 2 0 0 0 in
  acc;

let usage =
  "usage: mpng info <file.png>  |  mpng ppm <file.png> <out.ppm>  |  mpng encode <in.ppm> <out.png>";

let encode_cmd = fn (path: str) -> fn (out: str) ->
  let data = read_file_bytes path in
  let f = read_ppm data in
  if vec_len f < 4 then print "not a PPM this can read (P6 only)"
  else
    let width = vec_get f 0 in
    let height = vec_get f 1 in
    let start = vec_get f 3 in
    let pixels = vec_new () in
    let rec copy = fn (i: int) ->
      if i >= width * height * 3 then ()
      else let _ = vec_push pixels (vec_get data (start + i)) in copy (i + 1) in
    let _ = copy 0 in
    let png = encode_rgb8 pixels width height in
    let _ = write_file_bytes out png in
    print (str_of_int width ++ "x" ++ str_of_int height ++ " -> " ++ out
           ++ " (" ++ str_of_int (vec_len png) ++ " bytes)");

let main = fn () ->
  match args () with
  | Cons ("encode", Cons (path, Cons (out, _))) -> encode_cmd path out
  | Cons (cmd, Cons (path, rest)) ->
    let data = read_file_bytes path in
    if is_png data == false then print "not a PNG"
    else if cmd == "info" then info data
    else if is_interlaced data then
      // Refusing is the point: ignoring the flag decodes an interlaced file into
      // a plausible-looking wrong image, which is worse than not decoding it.
      print "interlaced (Adam7) is not supported yet"

    else if cmd == "ppm" then
      (match rest with
       | Cons (out, _) ->
         let bytes = ppm_bytes data in
         let _ = write_file_bytes out bytes in
         print (str_of_int (vec_len bytes) ++ " bytes -> " ++ out)
       | Nil -> print usage)
    else print usage
  | Cons (cmd, Nil) -> print usage
  | _ -> print usage;
let _ = main () in
// Exit explicitly, or the runtime echoes this program's own final value — `()`
// and a newline — after the PPM, and three bytes of that is the difference
// between an image and a corrupt file.
exit 0
